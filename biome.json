{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/next-env.d.ts",
      "!**/*.tsbuildinfo",
      "!apps/api/drizzle/meta",
      "!apps/api/openapi.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 50,
            "skipBlankLines": true
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 4
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "style": {
        "noNamespace": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "noNonNullAssertion": "error",
        "noEnum": "error",
        "noProcessEnv": "error",
        "noDefaultExport": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 300,
            "skipBlankLines": true
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "performance": {
        "noBarrelFile": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.spec.ts", "**/*.e2e-spec.ts", "**/*.test.ts"],
      "linter": {
        "domains": {
          "test": "recommended"
        },
        "rules": {
          "suspicious": {
            "noSkippedTests": "error",
            "noFocusedTests": "error"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 500,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "domains": {
          "next": "recommended",
          "react": "recommended"
        },
        "rules": {
          "nursery": {
            "useSortedClasses": {
              "level": "error",
              "fix": "safe",
              "options": {
                "functions": ["cn", "cva"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/**"],
      "javascript": {
        "parser": {
          "unsafeParameterDecoratorsEnabled": true
        }
      },
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          },
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.config.ts",
        "**/*.config.mjs",
        "**/*.config.e2e.ts",
        "apps/web/app/**/page.tsx",
        "apps/web/app/**/layout.tsx",
        "apps/web/app/**/loading.tsx",
        "apps/web/app/**/error.tsx",
        "apps/web/app/**/global-error.tsx",
        "apps/web/app/**/not-found.tsx",
        "apps/web/app/**/template.tsx",
        "apps/web/app/**/default.tsx",
        "apps/web/app/**/opengraph-image.tsx",
        "apps/web/app/**/sitemap.ts",
        "apps/web/app/**/robots.ts",
        "apps/web/app/**/manifest.ts",
        "apps/web/lib/i18n/request.ts",
        "apps/web/cache-handlers/redis.ts",
        "apps/asset-proxy/src/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.config.ts",
        "**/*.config.e2e.ts",
        "apps/api/src/config/env.ts",
        "apps/api/test/setup/**",
        "apps/music-catalog/src/config/env.ts",
        "apps/music-catalog/test/setup/**",
        "apps/web/lib/env/**",
        "apps/web/cache-handlers/redis.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/src/index.ts",
        "apps/api/src/database/schema/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
