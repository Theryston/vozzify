# BuildKit uses this allowlist for the API image's repository-root context.
*
!package.json
!nub.lock
!tsconfig.base.json
!apps/*/package.json
!packages/*/package.json
!packages/contracts
!apps/api

**/node_modules
**/dist
**/coverage
**/coverage-e2e
**/reports
**/.stryker-tmp
**/*.tsbuildinfo
**/.env
**/.env.*
**/*.spec.ts
apps/api/test
apps/api/sonic
