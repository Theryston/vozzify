NODE_ENV=development
PORT=3333
# Comma-separated list of web origins allowed by CORS (with credentials).
WEB_ORIGINS=http://localhost:3000
# OpenAPI docs at /docs. Defaults to true outside production.
SWAGGER_ENABLED=true

# Postgres connection string (docker-compose defaults).
DATABASE_URL=postgres://vozzify:vozzify@localhost:5432/vozzify

# Redis for BullMQ queues, response cache and rate limiting.
REDIS_URL=redis://localhost:6379
# Express `trust proxy` (sets which proxies may report the client IP via
# X-Forwarded-For, which rate limiting keys on): a hop count, true/false, or a
# comma-separated list of addresses/subnets. The default trusts only private
# networks (e.g. the Coolify/Traefik container network). With a CDN in front,
# use the number of proxies between the client and the app (e.g. 2).
TRUST_PROXY=loopback, linklocal, uniquelocal
# Global rate limit per client IP: RATE_LIMIT_MAX requests per window.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Base URL of the web app, used to call its cache revalidation endpoint.
WEB_URL=http://localhost:3000
# Same value as the web app's REVALIDATE_SECRET (min 32 chars, random in
# prod). Required in production; when unset elsewhere, revalidation jobs are
# logged and skipped.
REVALIDATE_SECRET=local-dev-revalidate-secret-change-me

# Better Auth. The secret signs session cookies: random, at least 32 chars
# (`openssl rand -base64 32`); rotating it signs everyone out. Required
# everywhere except NODE_ENV=test.
BETTER_AUTH_SECRET=local-dev-better-auth-secret-change-me-please
# Public base URL of this API, without /v1 (OAuth callbacks are built from it).
BETTER_AUTH_URL=http://localhost:3333
# Registrable domain shared by web and API (e.g. vozzify.com when the
# API runs on a subdomain), so the web server also receives the session cookie
# and can forward it. Leave empty locally: cookies ignore ports, so
# localhost:3000 and localhost:3333 already share them.
AUTH_COOKIE_DOMAIN=
# Google sign-in, enabled only when both are set. Authorized redirect URI:
# <BETTER_AUTH_URL>/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (verification and password-reset codes) via Resend.
# Required in production; when empty elsewhere, emails are printed to the API
# logs instead of being sent.
# Automatic reconciliation of an ambiguous price notice also requires this
# key to read sent emails. A sending-only key leaves such notices for review.
RESEND_API_KEY=
EMAIL_FROM=vozzify <noreply@vozzify.com>

# S3-compatible file storage for uploads (Avatars): the MinIO from
# docker-compose locally (`nub run infra:up` creates the bucket), AWS S3 in
# production. The API refuses to boot when this is incomplete.
# Endpoint and path style are only for S3-compatible servers: leave both unset
# on AWS.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vozzify
S3_ACCESS_KEY_ID=vozzify
S3_SECRET_ACCESS_KEY=vozzify-local
S3_FORCE_PATH_STYLE=true
# Base URL the stored files are served from, without the key (production:
# https://files.vozzify.com). Locally MinIO serves them under the bucket.
S3_PUBLIC_URL=http://localhost:9000/vozzify

# Private Music catalog WebSocket, dialed once at boot for public search.
# Required in production; locally the music-catalog dev stack on port 3334.
MUSIC_CATALOG_URL=ws://localhost:3334
# Key sent as `Authorization: Bearer <key>` in the catalog handshake (one of
# the catalog's API_KEYS, at least 32 characters).
MUSIC_CATALOG_API_KEY=local-dev-music-catalog-api-key-change-me
# How long one catalog search may wait before falling back (milliseconds).
MUSIC_CATALOG_REQUEST_TIMEOUT_MS=5000

# API-owned Sonic fallback search index. Sonic uses its TCP channel protocol,
# with separate short-lived search and ingestion sessions. Keep its persistent
# store on storage outside the Music catalog's household failure domain.
SONIC_HOST=localhost
SONIC_PORT=1491
SONIC_AUTH_PASSWORD=local-dev-sonic-password-change-me
SONIC_REQUEST_TIMEOUT_MS=5000

# Limits on a User's Track requests (admins are exempt): at most this many
# non-terminal Processings started by the User, and this many new Tracks per
# UTC day. Defaults 3 and 20 when unset.
PROCESSING_ACTIVE_LIMIT=3
PROCESSING_NEW_TRACKS_DAILY_LIMIT=20
# Longest Recording or video (seconds) a Processing accepts, checked before any
# download. Default 900 (15 minutes) when unset.
PROCESSING_MAX_DURATION_SECONDS=900
# Bright Data proxy for YouTube Music requests (only when YouTube blocks this
# server's IP). All four are needed together; leave them empty otherwise.
BRIGHT_DATA_PROXY_HOST=
BRIGHT_DATA_PROXY_PORT=
BRIGHT_DATA_PROXY_USERNAME=
BRIGHT_DATA_PROXY_PASSWORD=

# RapidAPI key of the audio download a Processing starts with (the YouTube to
# MP3 service the legacy app used, ADR 0004). Required in production: the API
# refuses to boot there without it. Elsewhere, a Processing without it fails its
# download with DOWNLOAD_FAILED.
RAPIDAPI_API_KEY=
# The ffmpeg binary that converts the downloaded audio to WAV. The API needs
# ffmpeg installed (the production image too). Unset, `ffmpeg` on the PATH is used.
FFMPEG_PATH=ffmpeg

# RunPod serverless endpoint running apps/note-detector, which separates the vocals
# and detects the notes of a Processing (ADR 0004). API key and endpoint ID are
# required in production: the API refuses to boot without them. Elsewhere, a
# Processing without them fails its note detection with NOTE_DETECTION_FAILED.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# ElevenLabs key of the Timed lyrics transcription (Scribe v2). Required in
# production: the API refuses to boot there without it. Elsewhere, a Processing
# without it completes without Timed lyrics.
ELEVENLABS_API_KEY=

# Billing is test-mode only until the complete billing policy is delivered.
# Stripe endpoint: POST /v1/billing/stripe-webhook. Locally use stripe listen.
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
# Create a Stripe Customer Portal configuration in test mode with payment-method
# updates and invoice history enabled, cancellation set to end of billing period,
# and subscription updates disabled. Set its bpc_ ID above. The API verifies
# these settings before it opens a portal session.
