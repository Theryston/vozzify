# Server-only: base URL the Next server uses to reach the API (no /v1 suffix).
API_URL=http://localhost:3333
# Server-only: shared secret the API sends as `Authorization: Bearer <secret>`
# to POST /api/revalidate. At least 32 characters; use a random value in prod.
REVALIDATE_SECRET=local-dev-revalidate-secret-change-me
# Server-only, optional: Redis shared by every web instance for the
# 'use cache' entries and tag invalidations (`nub run infra:up` starts one on
# 6380). Leave it empty to use Next's per-process in-memory cache.
CACHE_REDIS_URL=redis://localhost:6380
# Server-only, optional: comma-separated extra domains the sitemaps and
# robots.txt answer for, besides NEXT_PUBLIC_SITE_URL's host (bare hosts such
# as `vozzify.example`). Any other host gets NEXT_PUBLIC_SITE_URL's origin.
SITEMAP_EXTRA_HOSTS=
# Server-only, e2e builds only: `true` makes the practice page play with a fake
# clock instead of YouTube. Leave it `false` everywhere else.
E2E_FAKE_PLAYER=false

# Public (inlined into the browser bundle at build time): API base URL the
# browser calls directly (no /v1 suffix).
NEXT_PUBLIC_API_URL=http://localhost:3333
# Public origin of the site, used for absolute canonical/hreflang URLs.
# Baked into static pages at build time: pass it as a build arg for production
# images (https://vozzify.com). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only when building the real production deployment. Production-mode
# e2e builds leave this false so they never send analytics to Google.
NEXT_PUBLIC_GTM_ENABLED=false

# Server-only controls for Home In-feed placements. Public values are sent to
# the Home client only after every real account value is supplied.
ADSENSE_ENABLED=false
ADSENSE_CLIENT=
ADSENSE_SLOT=
ADSENSE_LAYOUT_KEY=
ADSENSE_CMP_URL=

# The API returns image URLs on https://assets.vozzify.com/storage in production.

# Production image: ghcr.io/theryston/vozzify/web:latest, port 3000.
# Its workflow passes the NEXT_PUBLIC_* values above as Docker build args.
# Set API_URL, REVALIDATE_SECRET (the same as the API) and CACHE_REDIS_URL at
# runtime. The image does not need these private settings during its build.
