{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-ort-wasm.ts",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/copy-ort-wasm.ts",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . && depcruise . --config .dependency-cruiser.cjs",
    "format": "biome check --write .",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:real-search": "playwright test --config=playwright.real-search.config.ts",
    "bundle:check": "node scripts/check-bundle-budget.ts",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@vozzify/contracts": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "input-otp": "^1.5.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.4",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "onnxruntime-web": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tone": "^15.1.22",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.4.0",
    "happy-dom": "^21.0.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
