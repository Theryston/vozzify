# BuildKit allowlist for the web image's repository-root context.
*
!package.json
!nub.lock
!tsconfig.base.json
!apps/*/package.json
!packages/*/package.json
!packages/contracts
!apps/web

**/node_modules
**/dist
**/coverage
**/coverage-e2e
**/reports
**/.stryker-tmp
**/*.tsbuildinfo
**/.env
**/.env.*
**/*.test.ts
**/*.spec.ts
apps/web/.next
apps/web/e2e
apps/web/playwright*.ts
apps/web/playwright-report
apps/web/test-results
apps/web/public/ort
apps/web/cache-handlers/fake-redis.ts
apps/web/Dockerfile*
