{
  "name": "asset-proxy",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "smoke:fixtures": "node scripts/create-smoke-fixtures.mjs",
    "smoke:web": "node scripts/serve-smoke.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.4",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "wrangler": "^4.45.0"
  }
}
