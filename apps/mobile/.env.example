# Android emulator: 10.0.2.2 reaches the host machine's localhost.
# On a physical Android device, use the computer's LAN IP, for example
# http://192.168.1.20:3333 (the device and computer must share a network).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3333

# Optional public OAuth IDs for the selected APP_VARIANT (never a client secret).
# Android needs the Web/server client ID. iOS also needs its own client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
