# The Music catalog's PRODUCTION environment (compose.yaml reads it from `.env`
# in this folder). Copy it to `.env`, fill it in, `chmod 600 .env` and never
# commit it. Every value below is a PLACEHOLDER (so is the example key): a
# `change-me` that reaches production is a public secret. The operations
# guide is apps/music-catalog/CLAUDE.md, "Operations (production)". The
# processes validate their own environment at startup and refuse to boot on a
# bad value, with every problem listed in their log.

# ---------------------------------------------------------------- Public door

# The domain Caddy gets a TLS certificate for (automatic HTTPS). Its DNS
# record must point at this server and ports 80 and 443 must be reachable.
# `localhost` serves a locally signed certificate: that is what the smoke run
# uses, never production.
CATALOG_DOMAIN=catalog.example.com

# Comma-separated API keys; a client sends one as `Authorization: Bearer <key>`
# in the WebSocket handshake. Each key is at least 32 characters. To rotate,
# list the new key next to the old one, move the clients, then drop the old
# one. Generate each with `openssl rand -base64 32`.
API_KEYS=change-me-api-key-0123456789abcdef0123456789abcdef

# ---------------------------------------------------------------------- Images

# Where CI publishes the two images (music-catalog and music-catalog-mbslave)
# and the tag to run. `latest` follows main; for a pinned, reproducible deploy
# use the `sha-<short commit>` tag of a build from the Actions run. Both
# images share the tag, so one value moves them together.
IMAGE_REPOSITORY=ghcr.io/theryston/vozzify
IMAGE_TAG=latest

# --------------------------------------------------------------------- Dataset

# `full` restores all of MusicBrainz (production: hours the first time, about
# 150-220 GB steady state); `tiny` seeds 300 Recordings in seconds and is only
# for the smoke run. The first import records it: switching later means
# resetting the databases.
CATALOG_DATASET=full

# The `.../data` directory the full MusicBrainz export is published under.
# `tiny` ignores it.
MUSICBRAINZ_DUMP_BASE_URL=https://data.metabrainz.org/pub/musicbrainz/data

# The MetaBrainz access token mbslave replicates with (required in `full`,
# ignored in `tiny`): the 40-character token from your MetaBrainz profile
# page, free for non-commercial use. Either the token itself, or a path to a
# file holding it (Docker secrets; mount the file with a compose override).
MBSLAVE_MUSICBRAINZ_TOKEN=change-me-40-character-metabrainz-token
# MBSLAVE_MUSICBRAINZ_TOKEN_FILE=/run/secrets/musicbrainz-token

# ---------------------------------------------------------------------- Postgres

# One role for mbslave, the server and the worker, and the database it owns.
# It is a superuser (it owns the database), which `mbslave init` needs. The
# password goes into a connection URL: use URL-safe characters only
# (`openssl rand -hex 24`).
POSTGRES_USER=music_catalog
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=music_catalog

# A starting point for the full restore; scale to the server's RAM.
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_MAX_WAL_SIZE=8GB
POSTGRES_MAINTENANCE_WORK_MEM=1GB

# ----------------------------------------------------------------- Meilisearch

# The master key (at least 16 bytes; `openssl rand -hex 32`). Neither the
# server nor the worker ever receives it: they use the two keys below.
MEILISEARCH_MASTER_KEY=change-me-meilisearch-master-key-0123456789abcdef

# The server's search-only key and the worker's write key. A Meilisearch key
# is HMAC-SHA256 of its uid with the master key, and the stack creates the two
# with fixed uids (compose.yaml, `meilisearch-init`), so their values are
# computed once from the master key:
#
#   printf '%s' '5ea2c4a1-0000-4000-8000-000000000001' | openssl dgst -sha256 -hmac "$MASTER" -hex   # search
#   printf '%s' '5ea2c4a1-0000-4000-8000-000000000002' | openssl dgst -sha256 -hmac "$MASTER" -hex   # write
#
# (keep only the 64-character hex value). The two below are derived from the
# placeholder master key above: recompute both whenever you change it.
MEILISEARCH_SEARCH_API_KEY=6db15b5b095a741ef71034877cba5c6329cf43029ad48c12d6e3a16d4416de29
MEILISEARCH_WRITE_API_KEY=ddd801b15a9a7b7bcfea72bc86afecec11969c81f4f9aea39609f465999744ae

# Recordings the worker sends to Meilisearch per task while indexing: bigger
# batches index faster and use more memory, smaller ones checkpoint more often.
# Initial indexing reads at most 10000 rows at a time and combines them into
# tasks of at most 50000 documents, with at most two tasks pending.
# Incremental sync stays capped at 10000 entries per batch.
INDEXING_BATCH_SIZE=50000

# ------------------------------------------------------------------- Server

# A connection that misses a pong for one whole interval is dropped (ms), and
# a request unanswered after the timeout gets an INTERNAL error (ms).
HEARTBEAT_INTERVAL_MS=30000
REQUEST_TIMEOUT_MS=10000

# ----------------------------------------------------------- Yearly reimport

# Only used once a year, when MusicBrainz changes its schema (CLAUDE.md,
# "Yearly schema change"); leave all three commented out until then. The
# REIMPORT_ ones must be absent, never blank (a blank is not a valid URL and
# the processes refuse to start on it).
#
# The parallel database the blue-green reimport rebuilds the catalog in: a
# fresh database on the same Postgres, migrated first. Name it after the
# year of the reimport (`<POSTGRES_DB>_2027`, then `_2028`, ...), which also
# makes every name new.
# REIMPORT_DATABASE_URL=postgres://music_catalog:change-me-postgres-password@postgres:5432/music_catalog_2027
#
# The database the service serves, when it is no longer the one Postgres
# created (POSTGRES_DB). After a reimport flips, set it to the new database
# and comment REIMPORT_DATABASE_URL out: mbslave's own binary connects to
# whatever this names and does not follow the flip by itself.
# CATALOG_DATABASE=music_catalog_2027
#
# Set to `false` to keep the retired database after the flip for inspection.
# REIMPORT_CLEANUP_OLD_COPY=false
