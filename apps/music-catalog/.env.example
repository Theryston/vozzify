NODE_ENV=development
# WebSocket endpoint of the server process (ws://localhost:3334). 0 picks a
# free port.
PORT=3334

# The service's own Postgres: `nub run infra:up` starts it on port 5433
# (the API's Postgres uses 5432).
DATABASE_URL=postgres://music_catalog:music_catalog@localhost:5433/music_catalog

# Comma-separated API keys; a client sends one as `Authorization: Bearer <key>`
# in the WebSocket handshake. Each key is at least 32 characters. To rotate a
# key, list the new one next to the old one, move the clients, then drop the
# old one. Generate real ones with `openssl rand -base64 32`.
API_KEYS=local-dev-music-catalog-api-key-change-me

# `tiny` seeds a small deterministic catalog locally in seconds
# (development); `full` restores all of MusicBrainz (production). The choice
# is recorded by the first import.
CATALOG_DATASET=tiny

# The `.../data` directory the full MusicBrainz export is published under.
# The mbslave container restores `full` from `<here>/fullexport/` (core plus
# derived tar.bz2, no edit history), reading that dataset's LATEST file
# first. `tiny` downloads nothing and ignores this. Point it at a fake server
# in tests, never at a mirror that does not publish the layout.
MUSICBRAINZ_DUMP_BASE_URL=https://data.metabrainz.org/pub/musicbrainz/data

# The mbslave release running in the mbslave container, baked into its image
# from the build argument (see mbslave.Dockerfile). Recorded with a
# schema-change stall, so the reimport starts once the container runs a
# newer mbslave major than the stalled one. Unset outside the image (local
# runs never reimport).
# MBSLAVE_REF=v31.0.1

# The parallel database the blue-green reimport rebuilds the catalog in
# after MusicBrainz's yearly schema change (same server, other database,
# migrated with `DATABASE_URL=<here> nub run db:migrate`). Unset, nothing
# ever reimports. The worker reads it too (its own copy of the setting),
# and the server for its boot fallback after a flip that dropped the
# retired copy.
# REIMPORT_DATABASE_URL=postgres://music_catalog:music_catalog@localhost:5433/music_catalog_next

# Drop the retired database after the flip (the default path). Set to
# 'false' to keep it for inspection, then the runbook in CLAUDE.md drops it.
# REIMPORT_CLEANUP_OLD_COPY=false

# The MetaBrainz access token the mbslave container replicates with in `full`
# mode (required there, ignored in `tiny`): the 40-character token from the
# MetaBrainz profile page, free for non-commercial use (see CLAUDE.md
# "Replication"). Set either the token itself or a file holding it (Docker
# secrets, Coolify secret files); the compose file passes both through.
# MBSLAVE_MUSICBRAINZ_TOKEN=...
# MBSLAVE_MUSICBRAINZ_TOKEN_FILE=/run/secrets/musicbrainz-token

# A connection that misses a pong for one whole interval is dropped.
HEARTBEAT_INTERVAL_MS=30000
# A request unanswered after this long gets an INTERNAL error.
REQUEST_TIMEOUT_MS=10000

# Meilisearch, the search engine: `nub run infra:up` starts it on port 7700
# (master key `local-dev-meilisearch-master-key`) and a job that creates the
# two keys below. Each process reads only its own: the server's key can only
# search and the worker's can manage the index and its documents. In
# production the compose creates them and you derive their values from the
# master key (see CLAUDE.md "Operations (production)", "Meilisearch keys").
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_SEARCH_API_KEY=121340fafb7e093b89f6a19190add33397ac663343cb4c9f76baff8ae1a5eb40
MEILISEARCH_WRITE_API_KEY=95695a2e89c1b56566c1e3d54b9e030dd033d42c3a3efe351b5f1c46fc839cb8

# Recordings the worker sends to Meilisearch per task while indexing: bigger
# batches index faster and use more memory, smaller ones checkpoint more often.
# Initial indexing reads at most 10000 rows at a time and combines them into
# tasks of at most 50000 documents, with at most two tasks pending.
# Incremental sync stays capped at 10000 entries per batch.
INDEXING_BATCH_SIZE=50000

# A file the worker keeps touching while it runs, which the production
# container's health check reads (deploy/compose.yaml). Leave it unset in
# development: nothing is written and nothing checks it.
# WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat
