{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["biome.json", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_GTM_ENABLED"],
      // `public/ort` is generated by the web prebuild (ONNX Runtime WASM,
      // git-ignored): without it a cache hit restores `.next` but the pitch
      // engine's model never loads, so the mic e2e tests time out.
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "public/ort/**"
      ]
    },
    "@vozzify/design-tokens#build": {
      "outputs": ["src/*.css"]
    },
    "lint": {},
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "PLAYWRIGHT_*",
        "DOCKER_*",
        "TESTCONTAINERS_*",
        "E2E_DATABASE_URL"
      ]
    },
    "web#test:e2e": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "passThroughEnv": ["CI", "PLAYWRIGHT_*"]
    },
    "format": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
